       <item row="7" column="1">
        <widget class="QLineEdit" name="ha_ssh_password">
         <property name="echoMode">
          <enum>QLineEdit::Password</enum>
         </property>
         <property name="placeholderText">
          <string>Optional: else your SSH key</string>
         </property>
        </widget>
       </item>
       <item row="8" column="0">
        <widget class="QLabel" name="lbl_ha_ssh_port">
         <property name="text">
          <string>SSH port</string>
         </property>
        </widget>
       </item>
       <item row="8" column="1">
        <widget class="QSpinBox" name="ha_ssh_port">
         <property name="minimum">
          <number>1</number>
         </property>
         <property name="maximum">
          <number>65535</number>
         </property>
         <property name="singleStep">
          <number>1</number>
         </property>
        </widget>
       </item>
       <item row="9" column="0">
        <widget class="QLabel" name="lbl_ha_log_command">
         <property name="text">
          <string>Log command</string>
         </property>
        </widget>
       </item>
       <item row="9" column="1">
        <widget class="QLineEdit" name="ha_log_command">
         <property name="placeholderText">
          <string notr="true">ha core logs -n 200 -f</string>
         </property>
        </widget>
       </item>
       <item row="10" column="0" colspan="2">
        <widget class="QLabel" name="lbl_ha_ssh_hint">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Optional: with an address, the Terminal tab gets a Home Assistant console and log. On Home Assistant OS, install the Terminal &amp; SSH add-on and set its SSH port in the add-on's Network settings, then either paste your public key (~/.ssh/id_ed25519.pub) in its authorized_keys option, or set a password in its options and here (kept encrypted, like the token; needs OpenSSH 8.4 or newer). The log command runs there: Home Assistant OS keeps its log in the system journal, read with ha core logs.</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
