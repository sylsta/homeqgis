          <item row="3" column="0" colspan="2">
           <widget class="QCheckBox" name="chk_advanced">
            <property name="text">
             <string>Show the advanced tools: Terminal (consoles and logs in QGIS), Wi-Fi recorder on the robot, boot watch, editing of no-go zones</string>
