       <item row="3" column="0" colspan="2">
        <widget class="QLabel" name="lbl_ha_hint">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Optional: your Home Assistant server. The token is optional too, but without it the plugin can only check that Home Assistant is there. Create it in Home Assistant, on your profile page (Security › Long-lived access tokens). It is kept encrypted in the QGIS authentication database, which may ask for your master password.</string>
         </property>
        </widget>
       </item>
