     <widget class="QWidget" name="tab_backup">
      <attribute name="title">
       <string>Backup</string>
      </attribute>
      <layout class="QVBoxLayout" name="backup_layout">
       <item>
        <layout class="QHBoxLayout" name="backup_folder_layout" stretch="0,1,0,0">
         <item>
          <widget class="QLabel" name="lbl_backup_folder">
           <property name="text">
            <string>Folder</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLineEdit" name="backup_folder">
           <property name="readOnly">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_backup_browse">
           <property name="text">
            <string>…</string>
           </property>
           <property name="toolTip">
            <string>Choose the folder</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btn_backup_open">
           <property name="text">
            <string>Open</string>
           </property>
           <property name="toolTip">
            <string>Open the folder in the file manager</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QListWidget" name="list_backups">
         <property name="toolTip">
          <string>Saved configurations, newest first: double-click to load</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chk_backup_secrets">
         <property name="text">
          <string>Include tokens and passwords (written in clear in the file)</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="backup_buttons">
         <item>
          <widget class="QPushButton" name="btn_backup_save">
           <property name="text">
            <string>Save now</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_backup_load">
           <property name="text">
            <string>Load selected…</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_backup_load_file">
           <property name="text">
            <string>Load a file…</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_backup_reset">
           <property name="text">
            <string>Reset config</string>
           </property>
           <property name="toolTip">
            <string>Back to the default settings, after saving a backup</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="backup_spacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint">
            <size>
             <width>0</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="lbl_backup_status">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lbl_backup_hint">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Each save writes a new file named with its date and time (valetudo_qgis_config_YYYYMMDD_HHMMSS.json): all the settings of these tabs, the room groups and the panel's choices. Saving first applies the values on screen, as OK does. Loading a file replaces the current configuration at once, without waiting for OK.</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
