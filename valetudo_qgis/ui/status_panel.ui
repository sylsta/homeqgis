                </property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="edit_console">
                <property name="placeholderText">
                 <string>Command, then Enter (↑ ↓: history)</string>
                </property>
                <property name="toolTip">
                 <string>Runs on the robot, one command at a time, without a terminal: interactive programs (vi, top, less…) do not work, use e.g. top -b -n 1. cd is kept from one command to the next, variables are not.</string>
                </property>
